<Project>
  <!-- Shared settings: Unity's C# 9 / .NET Standard 2.1 profile and its scripting defines. -->
  <PropertyGroup>
    <UnityCheckHome Condition="'$(UNITY_CHECK_HOME)' != ''">$(UNITY_CHECK_HOME)</UnityCheckHome>
    <UnityCheckHome Condition="'$(UnityCheckHome)' == ''">$(HOME)/.unity-check</UnityCheckHome>
    <ProjectAssets>$(MSBuildThisFileDirectory)../../Demolition Men/Assets</ProjectAssets>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0618;CS0649;CS0414;CS0169;CS0067;CS1701;CS1702;CS0436;CS8632</NoWarn>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <BaseDefines>UNITY_6000_4_OR_NEWER;UNITY_6000_0_OR_NEWER;UNITY_2023_3_OR_NEWER;UNITY_2023_2_OR_NEWER;UNITY_2023_1_OR_NEWER;UNITY_2022_3_OR_NEWER;UNITY_2022_2_OR_NEWER;UNITY_2022_1_OR_NEWER;UNITY_2021_3_OR_NEWER;UNITY_2021_2_OR_NEWER;UNITY_2021_1_OR_NEWER;UNITY_2020_3_OR_NEWER;UNITY_2020_2_OR_NEWER;UNITY_2020_1_OR_NEWER;UNITY_2019_4_OR_NEWER;UNITY_2019_3_OR_NEWER;UNITY_2019_2_OR_NEWER;UNITY_2019_1_OR_NEWER;UNITY_2018_4_OR_NEWER;UNITY_2018_3_OR_NEWER;UNITY_STANDALONE_WIN;UNITY_STANDALONE;ENABLE_INPUT_SYSTEM;ENABLE_MONO;ENABLE_PROFILER;UNITY_ASSERTIONS;ENABLE_LEGACY_INPUT_MANAGER;UNITY_INPUT_SYSTEM_ENABLE_PHYSICS2D;UNITY_INPUT_SYSTEM_ENABLE_PHYSICS;UNITY_INPUT_SYSTEM_ENABLE_UI;UNITY_INPUT_SYSTEM_PLATFORM_SCROLL_DELTA;UNITY_INPUT_SYSTEM_PLATFORM_POLLING_FREQUENCY;UNITY_INPUTSYSTEM_SUPPORTS_MOUSE_SCRIPT_EVENTS;PACKAGE_PHYSICS;PACKAGE_PHYSICS2D;PACKAGE_TILEMAP;PACKAGE_ANIMATION;PACKAGE_UITOOLKIT;PACKAGE_INPUTSYSTEM</BaseDefines>
    <DefineConstants>$(BaseDefines);$(ExtraDefines)</DefineConstants>
    <OutputPath>$(UnityCheckHome)/out/$(MSBuildProjectName)/</OutputPath>
    <BaseIntermediateOutputPath>$(UnityCheckHome)/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(UnityRefs)' != 'false'">
    <Reference Include="$(UnityCheckHome)/mods/lib/net45/*.dll" Private="false" />
  </ItemGroup>
</Project>
